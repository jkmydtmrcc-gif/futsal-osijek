# ===========================================================================
#  MNK Osijek Kandit — varijable okoline
#  Kopiraj u `.env` za lokalni rad; na Vercelu se iste upisuju pod
#  Settings → Environment Variables.
# ===========================================================================

# --- Obavezno --------------------------------------------------------------

# Tajna kojom se potpisuje kolačić sesije. Najmanje 32 znaka.
# Generiraj: openssl rand -hex 32
SESSION_SECRET=

# Tko smije uređivati stranicu. Zarezom odvojeno, ime iza dvotočke.
# Samo ovi brojevi mogu dobiti kod za prijavu.
ADMIN_PHONES=+385911234567:Ime Prezime, +385981112223:Drugi Urednik

# --- Pohrana (Upstash Redis) ------------------------------------------------
# Bez ovoga objava nestaje pri ponovnom pokretanju poslužitelja.
# Na Vercelu: Storage → Upstash → Redis; varijable se upišu same.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- SMS --------------------------------------------------------------------
# Bez postavljenog davatelja kod se ispisuje u zapis poslužitelja
# (dobro za lokalnu probu, neupotrebljivo u produkciji).
# SMS_DRIVER=twilio | infobip | console

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+3851234567

# Infobip (hrvatski davatelj — obično povoljniji za HR brojeve)
INFOBIP_API_KEY=
INFOBIP_BASE_URL=https://xxxxx.api.infobip.com
INFOBIP_FROM=MNKOsijek
